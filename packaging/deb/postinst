#!/bin/sh
set -e

case "$1" in
    configure)
        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper unmask shoplanner.service >/dev/null || true

            if deb-systemd-helper --quiet was-enabled shoplanner.service; then
                deb-systemd-helper enable shoplanner.service >/dev/null || true
            else
                deb-systemd-helper update-state shoplanner.service >/dev/null || true
            fi
        fi

        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true

            if [ -n "${2:-}" ]; then
                deb-systemd-invoke try-restart shoplanner.service >/dev/null || true
            else
                deb-systemd-invoke start shoplanner.service >/dev/null || true
            fi
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
